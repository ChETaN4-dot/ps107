# BIS Saathi Root Environment Configuration Template
# Bureau of Indian Standards Official AI Assistant (PS107)

# Backend Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=bis_saathi_kb

# Embeddings (HuggingFace / SentenceTransformers)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# Multilingual AI Translation & Voice Services (Sarvam AI)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=mayura:v1

# Frontend Environment
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
